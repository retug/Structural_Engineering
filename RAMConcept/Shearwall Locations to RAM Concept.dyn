      "Code": "\"ATS Shearwall\";"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector,\r\n    FamilyInstance,\r\n    ElementId\r\n)\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n# Inputs\r\ncategory = IN[0]      # Dynamo Category\r\nfamilyName = IN[1]    # string\r\n\r\n# Convert Dynamo category Id (int) → Revit ElementId\r\ncatId = ElementId(category.Id)\r\n\r\n# Collect all instances in the category\r\ncollector = (FilteredElementCollector(doc)\r\n             .OfCategoryId(catId)\r\n             .WhereElementIsNotElementType())\r\n\r\nresults = []\r\n\r\n# Filter by family name\r\nfor el in collector:\r\n    if isinstance(el, FamilyInstance):\r\n        if el.Symbol.Family.Name == familyName:\r\n            results.append(el.ToDSType(True))\r\n\r\nOUT = results, category.Id, catId\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "71ff79f7c27e49d29b6064d8276c401e",
