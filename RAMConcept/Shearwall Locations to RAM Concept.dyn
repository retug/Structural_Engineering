      "Code": "\"Structural Framing\";"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "f94720c9d56646dea439058c6d06ddc7",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "45e37d3c4b7e40fb961443a079ee422f",
          "Name": "",
          "Description": "Value of expression at line 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "\"ATS Shearwall\";"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Dynamo geometry\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\n# Revit / Dynamo\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import FamilyInstance\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n# ---- INPUTS ----\r\n# IN[0] = list of family instances (from previous node)\r\nelems_in = IN[0][0]\r\nif not isinstance(elems_in, list):\r\n    elems_in = [elems_in]\r\n\r\n# unwrap to Revit API elements\r\nelems = [UnwrapElement(e) for e in elems_in]\r\n\r\nstart_pts = []\r\nlines = []\r\nlengthSWs = []\r\nfor fi in elems:\r\n    if not isinstance(fi, FamilyInstance):\r\n        continue\r\n\r\n    # Get length from \"Length\" parameter (internal units: feet)\r\n    length_param = fi.LookupParameter(\"Shearwall Length\")\r\n    lengthSWs.append(length_param)\r\n    if length_param is None:\r\n        continue\r\n    length = length_param.AsDouble()\r\n\r\n    # Get instance transform (origin + local axes)\r\n    t = fi.GetTransform()\r\n    origin = t.Origin      # assumed START point\r\n    direction = t.BasisX   # assumed along member axis\r\n\r\n    # End point = origin + length * direction\r\n\r\n    end_xyz = origin.Add(direction.Multiply(length))\r\n\r\n\r\n    # Convert XYZ → Dynamo Points\r\n    start_pt = Point.ByCoordinates(origin.X, origin.Y, origin.Z)\r\n    end_pt   = Point.ByCoordinates(end_xyz.X, end_xyz.Y, end_xyz.Z)\r\n\r\n    start_pts.append(start_pt)\r\n    lines.append(Line.ByStartPointEndPoint(start_pt, end_pt))\r\n\r\n# OUT: [list of start points, list of lines]\r\nOUT = (start_pts, lines, elems, lengthSWs)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b69c1f97a56a4ba8a4caedb66bb88090",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e6ecaf51575047de85c81b4ef5b8fd58",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "07aff54490f3443d885987a7f10268ce",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr, os, re\r\n\r\n# Dynamo geometry\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\n\r\n# Revit / Dynamo\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import FamilyInstance, UnitUtils\r\n\r\n# Units API detection\r\ntry:\r\n    # Revit 2022+ ForgeTypeId units\r\n    from Autodesk.Revit.DB import UnitTypeId\r\n    HAS_FORGE_UNITS = True\r\nexcept:\r\n    from Autodesk.Revit.DB import DisplayUnitType\r\n    HAS_FORGE_UNITS = False\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n# -----------------------\r\n# INPUTS\r\n# -----------------------\r\nelems_in = IN[0][0]  # list of family instances\r\nif not isinstance(elems_in, list):\r\n    elems_in = [elems_in]\r\n\r\nout_dir = IN[1] if len(IN) > 1 and IN[1] else os.path.expanduser(\"~/Desktop\")\r\nname_prefix = IN[2] if len(IN) > 2 and IN[2] else \"Wind\"\r\n\r\n# -----------------------\r\n# Helpers (same style as your sample)\r\n# -----------------------\r\ndef ensure_dir(p):\r\n    if not p:\r\n        raise Exception(\"Output directory path is required.\")\r\n    if not os.path.exists(p):\r\n        os.makedirs(p)\r\n\r\ndef try_excel_com_available():\r\n    \"\"\"Return (excel_app, ExcelModule) or (None, None) if COM not available.\"\"\"\r\n    try:\r\n        clr.AddReference('Microsoft.Office.Interop.Excel')\r\n        from Microsoft.Office.Interop import Excel\r\n        app = Excel.ApplicationClass()\r\n        app.Visible = False\r\n        app.DisplayAlerts = False\r\n        return app, Excel\r\n    except:\r\n        return None, None\r\n\r\ndef save_workbook(app, Excel, filepath, header, data_rows):\r\n    \"\"\"Create one workbook, write header, then many data rows, save as .xlsx.\"\"\"\r\n    wb = None\r\n    try:\r\n        wb = app.Workbooks.Add()\r\n        ws = wb.ActiveSheet\r\n\r\n        # Header\r\n        for c, h in enumerate(header, 1):\r\n            ws.Cells(1, c).Value2 = h\r\n\r\n        # Data rows\r\n        for r, data in enumerate(data_rows, 2):  # start at row 2\r\n            for c, v in enumerate(data, 1):\r\n                ws.Cells(r, c).Value2 = v\r\n\r\n        wb.SaveAs(filepath)\r\n    finally:\r\n        if wb is not None:\r\n            wb.Close(SaveChanges=False)\r\n\r\ndef save_csv(filepath, header, data_rows):\r\n    \"\"\"Fallback: write one CSV with header + all rows.\"\"\"\r\n    import csv\r\n    with open(filepath, mode='w', newline='') as f:\r\n        w = csv.writer(f)\r\n        w.writerow(header)\r\n        for row in data_rows:\r\n            w.writerow(row)\r\n\r\ndef write_one_file(excel_app, ExcelMod, base_path_no_ext, header, data_rows):\r\n    \"\"\"Write xlsx if Excel exists, else csv. Returns created_file path.\"\"\"\r\n    xlsx_path = base_path_no_ext + \".xlsx\"\r\n    csv_path  = base_path_no_ext + \".csv\"\r\n\r\n    if excel_app is not None:\r\n        save_workbook(excel_app, ExcelMod, xlsx_path, header, data_rows)\r\n        return xlsx_path\r\n    else:\r\n        save_csv(csv_path, header, data_rows)\r\n        return csv_path\r\n\r\ndef get_param_str(e, name):\r\n    p = e.LookupParameter(name)\r\n    if p is None:\r\n        return None\r\n    s = p.AsString()\r\n    if not s:\r\n        try:\r\n            s = p.AsValueString()\r\n        except:\r\n            s = None\r\n    return s\r\n\r\ndef _parse_value_string_to_float(s):\r\n    \"\"\"\r\n    Parse something like:\r\n      \"610.7 lb/ft\" -> 610.7\r\n      \"12.95\" -> 12.95\r\n      \"1,234.56 kips\" -> 1234.56\r\n    \"\"\"\r\n    if s is None:\r\n        return None\r\n    s = s.strip()\r\n    if not s:\r\n        return None\r\n    # remove commas, extract first float-like token\r\n    s = s.replace(\",\", \"\")\r\n    m = re.search(r\"[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\", s)\r\n    if not m:\r\n        return None\r\n    try:\r\n        return float(m.group(0))\r\n    except:\r\n        return None\r\n\r\ndef _get_display_units_id(param):\r\n    \"\"\"\r\n    Returns the unit id object if possible (ForgeTypeId in Revit 2022+),\r\n    otherwise returns DisplayUnitType in older Revit, or None.\r\n    \"\"\"\r\n    try:\r\n        # Revit 2022+: Parameter.GetUnitTypeId()\r\n        return param.GetUnitTypeId()\r\n    except:\r\n        pass\r\n\r\n    # Older: might be param.DisplayUnitType (not always available depending on Revit version)\r\n    try:\r\n        return param.DisplayUnitType\r\n    except:\r\n        return None\r\n\r\ndef _convert_internal_to_param_display(param, v_internal):\r\n    \"\"\"\r\n    Convert AsDouble internal value -> numeric in the parameter's *display unit*.\r\n    This is the closest match to the value you see in Properties/RevitLookup.\r\n    \"\"\"\r\n    # Try unit-aware conversion first\r\n    units_id = _get_display_units_id(param)\r\n    if units_id is not None:\r\n        try:\r\n            return UnitUtils.ConvertFromInternalUnits(v_internal, units_id)\r\n        except:\r\n            pass\r\n\r\n    # Fallback: parse AsValueString\r\n    try:\r\n        return _parse_value_string_to_float(param.AsValueString())\r\n    except:\r\n        return None\r\n\r\ndef get_param_double(e, name, desired=None):\r\n    \"\"\"\r\n    Returns the parameter value in desired units by:\r\n      1) converting AsDouble() -> parameter display units (using GetUnitTypeId)\r\n      2) converting from those display units into your requested output\r\n\r\n    desired:\r\n      - None      : returns in PARAM DISPLAY UNITS (matches what you see in UI)\r\n      - \"kip\"     : returns kips\r\n      - \"kip/ft\"  : returns kip/ft\r\n    \"\"\"\r\n    p = e.LookupParameter(name)\r\n    if p is None or (hasattr(p, \"HasValue\") and not p.HasValue):\r\n        return None\r\n\r\n    try:\r\n        v_internal = p.AsDouble()\r\n    except:\r\n        v_internal = None\r\n\r\n    # First: get the numeric value in the parameter's displayed units\r\n    v_disp = None\r\n    if v_internal is not None:\r\n        v_disp = _convert_internal_to_param_display(p, v_internal)\r\n\r\n    # If still None, try parse AsValueString anyway\r\n    if v_disp is None:\r\n        try:\r\n            v_disp = _parse_value_string_to_float(p.AsValueString())\r\n        except:\r\n            v_disp = None\r\n\r\n    if v_disp is None:\r\n        return None\r\n\r\n    if desired is None:\r\n        return v_disp\r\n\r\n    # Determine what the parameter's display unit *is* (string check is robust across versions)\r\n    unit_id = _get_display_units_id(p)\r\n    unit_str = str(unit_id).lower() if unit_id is not None else \"\"\r\n\r\n    # Now convert from display units -> desired\r\n    if desired == \"kip\":\r\n        # If parameter is already in kips, return directly\r\n        if \"kips\" in unit_str or \"kip\" in unit_str:\r\n            return v_disp\r\n        # If parameter is in pounds-force, convert to kips\r\n        if \"lb\" in unit_str or \"pound\" in unit_str:\r\n            return v_disp / 1000.0\r\n        # Unknown: assume already kips\r\n        return v_disp\r\n\r\n    if desired == \"kip/ft\":\r\n        # If already in kip/ft\r\n        if (\"kip\" in unit_str and \"foot\" in unit_str) or (\"kip\" in unit_str and \"/ft\" in unit_str):\r\n            return v_disp\r\n        # If in lb/ft, convert to kip/ft\r\n        if (\"lb\" in unit_str and \"foot\" in unit_str) or (\"lb\" in unit_str and \"/ft\" in unit_str) or (\"pound\" in unit_str and \"foot\" in unit_str):\r\n            return v_disp / 1000.0\r\n        # Unknown: assume lb/ft and convert\r\n        return v_disp / 1000.0\r\n\r\n    return v_disp\r\n\r\ndef safe_float(x, default=0.0):\r\n    try:\r\n        return float(x)\r\n    except:\r\n        return default\r\n\r\n# -----------------------\r\n# MAIN\r\n# -----------------------\r\nensure_dir(out_dir)\r\nview_name = doc.ActiveView.Name\r\n\r\n# Unwrap\r\nelems = [UnwrapElement(e) for e in elems_in]\r\n\r\n# Geometry outputs (optional)\r\nstart_pts = []\r\nlines = []\r\n\r\n# Build rows\r\nline_rows_X, line_rows_Y = [], []\r\npt_rows_X, pt_rows_Y     = [], []\r\n\r\nOFFSET_FT = 0.5  # 6\"\r\n\r\nWindValues = []\r\n\r\nfor fi in elems:\r\n    if not isinstance(fi, FamilyInstance):\r\n        continue\r\n\r\n    dir_xy = get_param_str(fi, \"Shear Wall Direction\")\r\n    if not dir_xy:\r\n        continue\r\n    dir_xy = dir_xy.strip().upper()\r\n    if dir_xy not in [\"X\", \"Y\"]:\r\n        continue\r\n\r\n    # Length (ft)\r\n    length_param = fi.LookupParameter(\"Shearwall Length\")\r\n    if length_param is None:\r\n        continue\r\n    length_ft = length_param.AsDouble()\r\n\r\n    # ---- FIXED UNIT PULLS ----\r\n    # Wind PLF: want kip/ft (even though UI shows lb/ft)\r\n    wind_plf = safe_float(get_param_double(fi, \"Wind PLF\", \"kip/ft\"), 0.0)\r\n\r\n    # Optional force value: want kips (if your parameter is set up that way)\r\n    wind_force = safe_float(get_param_double(fi, \"Wind Force\", \"kip\"), 0.0)\r\n    WindValues.append(wind_force)\r\n\r\n    # T_C Couple: UI shows kips; return kips (matches UI numeric)\r\n    tc = safe_float(get_param_double(fi, \"T_C Couple\", \"kip\"), 0.0)\r\n\r\n    # Transform-based geometry\r\n    t = fi.GetTransform()\r\n    origin = t.Origin\r\n    direction = t.BasisX\r\n\r\n    end_xyz = origin.Add(direction.Multiply(length_ft))\r\n\r\n    # Dynamo geometry outputs\r\n    start_pt_ds = Point.ByCoordinates(origin.X, origin.Y, origin.Z)\r\n    end_pt_ds   = Point.ByCoordinates(end_xyz.X, end_xyz.Y, end_xyz.Z)\r\n    start_pts.append(start_pt_ds)\r\n    lines.append(Line.ByStartPointEndPoint(start_pt_ds, end_pt_ds))\r\n\r\n    # -------- LINE LOAD ROW (Fx/Fy/Fz in kip/ft) --------\r\n    # Wall axis direction projected to XY (unit vector)\r\n    dx = float(direction.X)\r\n    dy = float(direction.Y)\r\n\r\n    mag = (dx*dx + dy*dy) ** 0.5\r\n    if mag > 1e-9:\r\n        ux = dx / mag\r\n        uy = dy / mag\r\n    else:\r\n        ux = 0.0\r\n        uy = 0.0\r\n\r\n    # Resolve WindPLF into global components (assumes PLF is along wall axis)\r\n    fx = wind_plf * ux\r\n    fy = wind_plf * uy\r\n    fz = 0.0\r\n\r\n    row_line = [\r\n        origin.X, origin.Y, origin.Z,\r\n        end_xyz.X, end_xyz.Y, end_xyz.Z,\r\n        fx, fy, fz,\r\n        view_name\r\n    ]\r\n\r\n    # -------- POINT LOAD ROWS (offset 6\" toward center), kips --------\r\n    p1 = origin.Add(direction.Multiply(OFFSET_FT))          # inset from start\r\n    p2 = end_xyz.Add(direction.Multiply(-OFFSET_FT))        # inset from end\r\n\r\n    row_p1 = [p1.X, p1.Y, p1.Z, 0, 0, +tc, view_name]\r\n    row_p2 = [p2.X, p2.Y, p2.Z, 0, 0, -tc, view_name]\r\n\r\n    if dir_xy == \"X\":\r\n        line_rows_X.append(row_line)\r\n        pt_rows_X.append(row_p1)\r\n        pt_rows_X.append(row_p2)\r\n    else:\r\n        line_rows_Y.append(row_line)\r\n        pt_rows_Y.append(row_p1)\r\n        pt_rows_Y.append(row_p2)\r\n\r\n# Headers (line loads)\r\nline_header = [\r\n    \"Start X (ft)\", \"Start Y (ft)\", \"Start Z (ft)\",\r\n    \"End X (ft)\",   \"End Y (ft)\",   \"End Z (ft)\",\r\n    \"Fx (kip/ft)\", \"Fy (kip/ft)\", \"Fz (kip/ft)\",\r\n    \"VIEW_NAME\"\r\n]\r\n\r\n# Headers (point loads)\r\npoint_header = [\r\n    \"X (ft)\", \"Y (ft)\", \"Z (ft)\",\r\n    \"FX (kip)\", \"FY (kip)\", \"FZ (kip)\",\r\n    \"VIEW_NAME\"\r\n]\r\n\r\ncreated_files = []\r\nerrors = []\r\n\r\nexcel_app, ExcelMod = try_excel_com_available()\r\ntry:\r\n    # Wind X line loads\r\n    created_files.append(write_one_file(\r\n        excel_app, ExcelMod,\r\n        os.path.join(out_dir, \"{} X\".format(name_prefix)),\r\n        line_header, line_rows_X\r\n    ))\r\n\r\n    # Wind Y line loads\r\n    created_files.append(write_one_file(\r\n        excel_app, ExcelMod,\r\n        os.path.join(out_dir, \"{} Y\".format(name_prefix)),\r\n        line_header, line_rows_Y\r\n    ))\r\n\r\n    # Wind X point loads\r\n    created_files.append(write_one_file(\r\n        excel_app, ExcelMod,\r\n        os.path.join(out_dir, \"{} X - PointLoads\".format(name_prefix)),\r\n        point_header, pt_rows_X\r\n    ))\r\n\r\n    # Wind Y point loads\r\n    created_files.append(write_one_file(\r\n        excel_app, ExcelMod,\r\n        os.path.join(out_dir, \"{} Y - PointLoads\".format(name_prefix)),\r\n        point_header, pt_rows_Y\r\n    ))\r\n\r\nexcept Exception as e:\r\n    errors.append(str(e))\r\nfinally:\r\n    if excel_app is not None:\r\n        try:\r\n            excel_app.Quit()\r\n        except:\r\n            pass\r\n\r\nOUT = {\r\n    \"CreatedFiles\": created_files,\r\n    \"Errors\": errors,\r\n    \"StartPoints\": start_pts,\r\n    \"Lines\": lines,\r\n    \"Counts\": {\r\n        \"X_line\": len(line_rows_X),\r\n        \"Y_line\": len(line_rows_Y),\r\n        \"X_point\": len(pt_rows_X),\r\n        \"Y_point\": len(pt_rows_Y)\r\n    },\r\n    \"Wind Force (kip)\": WindValues,\r\n}\r\n",
      "Engine": "CPython3",
